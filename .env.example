NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Create an OAuth2 application in Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
# Comma-separated Discord user IDs allowed to upload, for example: 123456789012345678
DISCORD_ALLOWED_USER_IDS=

# Keep the Roblox key on the server. Never add it to the browser or commit it.
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_CREATOR_TYPE=user
ROBLOX_CREATOR_ID=
